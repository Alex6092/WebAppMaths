{
  "name": "webappmaths",
  "private": true,
  "type": "module",
  "description": "Application d'apprentissage multi-matières (CP → collège), exercices générés procéduralement.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "gen:registry": "tsx scripts/gen-registry.ts",
    "gen:emoji": "tsx scripts/gen-emoji.ts",
    "new:exercise": "tsx scripts/new-exercise.ts",
    "predev": "npm run gen:registry",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @app/server\" \"npm run dev -w @app/web\"",
    "prebuild": "npm run gen:registry",
    "build": "npm run build -w @app/web && npm run build -w @app/server",
    "pretest": "npm run gen:registry",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pretypecheck": "npm run gen:registry",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:icons": "tsx scripts/gen-icons.ts"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource/noto-color-emoji": "^5.3.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "prettier-plugin-svelte": "^4.1.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
