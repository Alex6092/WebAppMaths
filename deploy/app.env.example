# À copier en /opt/webappmaths/app.env (chmod 600) puis à adapter.

# Sous-chemin si l'app est servie en https://serveur.lycee.fr/apprendre/ ; sinon /
BASE_PATH=/
# Adresse publique, utilisée pour refuser les requêtes venues d'autres sites
PUBLIC_URL=https://apprendre.mon-lycee.fr
# Adresse(s) IP du reverse proxy (séparées par des virgules), ou true s'il est sur la même machine
TRUST_PROXY=127.0.0.1
# Cookies réservés au HTTPS (laisser true derrière le reverse proxy HTTPS)
COOKIE_SECURE=true
# Limites (valeurs par défaut) : essais de mot de passe par compte et par quart d'heure ;
# requêtes de connexion par adresse IP et par quart d'heure (une école entière sort souvent par
# la même adresse) ; requêtes par minute et par appareil connecté
# AUTH_ATTEMPTS=10
# AUTH_ATTEMPTS_PER_IP=300
# REQUESTS_PER_MINUTE=600
# Nombre de sauvegardes quotidiennes conservées
BACKUP_KEEP=14
LOG_LEVEL=info

# Voix du serveur (Piper, installé à côté de data/ par le déploiement)
# Phrases fabriquées en même temps (par défaut : nombre de cœurs − 1, 3 au plus)
# TTS_WORKERS=3
# Taille maximale du cache des phrases, en Mo
# TTS_CACHE_MB=500

# Mode systemd uniquement (en Docker, ces valeurs sont fixées par docker-compose.yml)
# PORT=3000
# HOST=127.0.0.1
