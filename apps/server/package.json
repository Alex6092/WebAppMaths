{
  "name": "@app/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Fastify + SQLite : comptes famille, profils, séances, tentatives recorrigées.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@app/content": "*",
    "@app/core": "*",
    "@app/themes": "*",
    "@fastify/cookie": "~11.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.3.0",
    "@node-rs/argon2": "^2.2.0",
    "better-sqlite3": "^12.11.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.25.0"
  }
}
